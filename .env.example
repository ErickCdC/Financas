# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Senha de entrada do app (mínimo 8 caracteres).
APP_PASSWORD=troque-por-uma-senha-longa
# Chave interna longa e aleatória (sessões e notificações). Ex.: python3 -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=

# Agendador: o mesmo valor vai no Secret CRON_TOKEN do GitHub.
CRON_TOKEN=
# Endereço público com https (no Render é preenchido sozinho).
PUBLIC_URL=

# Backup automático no GitHub (recomendado no Render grátis).
GITHUB_TOKEN=
GITHUB_REPO=ErickCdC/Financas
GITHUB_BRANCH=dados

# Opcional: Banco MCP.
BANCO_MCP_KEY=

# Só para o docker-compose.https.yml.
DOMINIO=
