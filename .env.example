# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Senha de entrada do app (mínimo 8 caracteres). Use uma senha longa e só sua.
APP_PASSWORD=troque-por-uma-senha-longa

# Opcional: chave da API do Banco MCP (habilita o botão "Sincronizar agora").
# Fica só no servidor, nunca vai pro navegador.
BANCO_MCP_KEY=

# Só se for usar o docker-compose.https.yml: o domínio que aponta pro servidor.
DOMINIO=
